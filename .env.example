# Required when the app is reachable from another machine.
PM_APP_TOKEN=replace-with-a-long-random-value

# Defaults to ./vault. An absolute directory is recommended for real data.
PM_VAULT_ROOT=

# Comma-separated browser origins allowed to call the API.
PM_CORS_ORIGINS=

# Optional GitHub synchronization to a SEPARATE PRIVATE vault repository.
PM_GITHUB_SYNC_ENABLED=false
PM_GITHUB_REPO=your-account/your-private-vault
PM_GITHUB_BRANCH=main
PM_GITHUB_TOKEN=
PM_GITHUB_AUTHOR_NAME=Markdown Task Manager
PM_GITHUB_AUTHOR_EMAIL=task-manager@example.invalid
